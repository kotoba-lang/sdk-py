;; etzhayyim-sdk — bb config for the cljc port (httpx→babashka.http-client). cheshire +
;; babashka.http-client are bb built-ins, so no :deps are needed. :paths puts the cljc
;; modules on the classpath so `kbb -e "(require 'etzhayyim-sdk.mst-projector)"` resolves when
;; run from this dir. This file is scoped to this directory and does not affect the repo-root
;; bb.edn. Tests: `kbb -M:test` (or `kbb run_tests.cljk`).
{:paths ["src"]
 :tasks
 {test {:doc "Run the cljc test suites under bb"
        :task (load-file "run_tests.cljk")}}}
